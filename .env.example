# Copy to .env.local ONLY on your local machine. Never commit real values.
# Preserve the two existing variables when deploying into the existing project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_EXISTING_ANON_KEY

# SERVER ONLY. Never prefix this key with NEXT_PUBLIC_. Never paste it into browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
