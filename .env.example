# Existing ACC BAU TOOLS project. Keep Production values unchanged.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix these names with NEXT_PUBLIC_.
# Privileged key of the SAME Supabase project, not the anon key.
SUPABASE_SERVICE_ROLE_KEY=
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
FLEET_SESSION_SECRET=

# One-time bootstrap. Prefer the exact employee name used in Tools.
# These are used ONLY while acc_fleet_members has no accounts.
FLEET_BOOTSTRAP_USER=
# At least 8 characters; use a strong random password, preferably 16+ characters.
FLEET_BOOTSTRAP_PIN=
# After the first successful login, remove the two bootstrap variables and redeploy.
# The account and hashed password remain in the database.
